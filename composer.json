            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "meteorites",
        "meteorite landings api",
        "meteorite search",
        "lookup meteorite strikes",
        "meteorite fall records",
        "search meteor landings"
    ],
    "homepage": "https://apiverve.com/marketplace/meteorites?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/meteorites",
        "source": "https://github.com/apiverve/meteorites-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Meteorites\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
